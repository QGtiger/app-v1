{
  "$schema": "https://opencode.ai/config.json",
  "model": "zhipuai-coding-plan/glm-5.3-flash",
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -rf /*": "deny",
      "rm -rf /": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "pnpm dev": "deny",
      "pnpm run dev": "deny",
      "npm run dev": "deny",
      "npm start": "deny",
      "vite": "deny",
      ":(){ :|:&: };:": "deny"
    },
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "deny"
  },
  "agent": {
    "build": {
      "prompt": "{file:./prompts/build.txt}"
    },
    "plan": {
      "prompt": "{file:./prompts/plan.txt}"
    },
    "qa-verify": {
      "description": "接收验收修改记录，定位源码并完成修复",
      "mode": "primary",
      "model": "zhipuai-coding-plan/glm-5.3-flash",
      "prompt": "{file:./prompts/qa-verify.txt}"
    }
  },
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "baseURL": "{env:DEEPSEEK_BASE_URL}"
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
        "baseURL": "{env:ANTHROPIC_BASE_URL}"
      }
    },
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}"
      }
    },
    "gemini": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },
    "zhipuai-coding-plan": {
      "options": {
        "apiKey": "{env:ZHIPU_API_KEY}"
      }
    }
  }
}
